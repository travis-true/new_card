# Required for card identification (Claude vision). Without it the scan page falls back to manual entry.
ANTHROPIC_API_KEY=
# Optional: override the model used for identification (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Required in production: long random string used to sign session cookies
SESSION_SECRET=
# Optional: where the SQLite file and uploaded images live (default ./data)
# DATA_DIR=./data
# Set to "mock" to return a fixed sample identification (development and tests only)
# IDENTIFY_MODE=mock
